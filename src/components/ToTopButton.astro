---
/**
 * ============================================================================
 * TO TOP FLOATING BUTTON (ToTopButton.astro)
 * ============================================================================
 * What this component does:
 * - Floating square button fixed at the bottom-right of the viewport.
 * - Smoothly scrolls the window back to top when clicked.
 * - Interaction logic is handled in src/scripts/navigation.ts.
 * ============================================================================
 */
---

<button
  id="to-top-button"
  class="to-top-button"
  type="button"
  title="To top"
  aria-label="To top"
>
  ↑
</button>
