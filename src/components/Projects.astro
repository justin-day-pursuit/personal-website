---
/**
 * ============================================================================
 * PROJECTS SECTION (Projects.astro)
 * ============================================================================
 * What this component does:
 * - Highlights your key software projects in a clean two-column responsive grid.
 *
 * HOW TO MAINTAIN:
 * - To edit an existing project: update the name, link, image, or bullet points
 *   inside any <article class="project-card">.
 * - To add a new project: copy an entire <article class="project-card"> block
 *   and paste it inside <div class="projects-grid">.
 * - Images can be placed in `public/` and linked via `<img src="/your-image.png" />`.
 * ============================================================================
 */
---

<section id="resume-projects" class="story-section container">
  <h2>Projects</h2>
  <p>
    This section highlights projects that reflect how I think, build, and
    deliver practical solutions.
  </p>
  <div class="projects-grid">
    <!-- PROJECT CARD 1 -->
    <article class="project-card">
      <div class="project-media" role="img" aria-label="Project 1 image placeholder">
        Project 1 Image
      </div>
      <div class="project-content">
        <h3>Project 1: [Project Name Placeholder]</h3>
        <p>
          <a
            href="https://example.com/project-one"
            target="_blank"
            rel="noopener noreferrer"
            >Open Project 1</a
          >
        </p>
        <ul>
          <li>Built to solve [specific problem placeholder] for [target users].</li>
          <li>Focused on clean architecture, usability, and measurable outcomes.</li>
        </ul>
      </div>
    </article>

    <!-- PROJECT CARD 2 -->
    <article class="project-card">
      <div class="project-media" role="img" aria-label="Project 2 image placeholder">
        Project 2 Image
      </div>
      <div class="project-content">
        <h3>Project 2: [Project Name Placeholder]</h3>
        <p>
          <a
            href="https://example.com/project-two"
            target="_blank"
            rel="noopener noreferrer"
            >Open Project 2</a
          >
        </p>
        <ul>
          <li>Designed and implemented [feature placeholder] end to end.</li>
          <li>Demonstrates adaptability, quick learning, and practical execution.</li>
        </ul>
      </div>
    </article>
  </div>
</section>
