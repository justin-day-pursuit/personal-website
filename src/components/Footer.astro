---
/**
 * ============================================================================
 * SITE FOOTER (Footer.astro)
 * ============================================================================
 * What this component does:
 * - Displays direct contact links: email address, LinkedIn profile, GitHub profile.
 * - Displays the copyright notice.
 *
 * HOW TO MAINTAIN:
 * - Update the email `href="mailto:..."` and text to change your contact email.
 * - Update the LinkedIn `href` or GitHub `href` to point to updated URLs.
 * - Update the copyright year if needed.
 * ============================================================================
 */
---

<footer class="site-footer">
  <div class="container footer-layout">
    <div class="footer-bottom">
      <ul class="contact-list">
        <!-- Direct Email -->
        <li>
          <a href="mailto:justin.day@pursuit.org" target="_blank" rel="noopener noreferrer">
            <span>justin.day@pursuit.org</span>
          </a>
        </li>

        <!-- LinkedIn Profile -->
        <li>
          <a
            href="https://www.linkedin.com/in/justin-day-192605164/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn"
            title="LinkedIn"
            class="social-icon-link"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M6.94 8.5V19H3.5V8.5h3.44ZM7.15 5.27c0 1.03-.77 1.85-1.93 1.85h-.02c-1.09 0-1.9-.82-1.9-1.85 0-1.06.83-1.86 1.94-1.86 1.11 0 1.88.8 1.91 1.86ZM20.5 12.98V19h-3.44v-5.62c0-1.41-.5-2.37-1.76-2.37-.96 0-1.53.65-1.78 1.28-.09.22-.11.53-.11.84V19H10V8.5h3.3v1.43c.48-.74 1.33-1.8 3.25-1.8 2.38 0 4.16 1.56 4.16 4.85Z"/>
            </svg>
          </a>
        </li>

        <!-- GitHub Profile -->
        <li>
          <a
            href="https://github.com/justin-day-pursuit"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="GitHub"
            title="GitHub"
            class="social-icon-link"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M12 .5a12 12 0 0 0-3.79 23.39c.6.1.82-.26.82-.58v-2.04c-3.34.73-4.04-1.41-4.04-1.41-.54-1.38-1.33-1.75-1.33-1.75-1.09-.75.08-.73.08-.73 1.2.08 1.84 1.24 1.84 1.24 1.08 1.84 2.82 1.31 3.5 1 .1-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.91 0-1.31.47-2.38 1.24-3.22-.12-.3-.54-1.52.12-3.17 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.29-1.55 3.3-1.23 3.3-1.23.66 1.65.24 2.87.12 3.17.77.84 1.24 1.91 1.24 3.22 0 4.59-2.81 5.61-5.49 5.9.43.38.81 1.1.81 2.22v3.29c0 .32.21.69.83.58A12 12 0 0 0 12 .5Z"/>
            </svg>
          </a>
        </li>
      </ul>
      <p class="copyright">&copy; 2026 Justin Day. All rights reserved.</p>
    </div>
  </div>
</footer>
