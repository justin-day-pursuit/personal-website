---
/**
 * ============================================================================
 * CONTACT SECTION (Contact.astro)
 * ============================================================================
 * What this component does:
 * - Provides an interactive direct message inquiry form.
 * - Submits asynchronously to FormSubmit without leaving the page.
 * - Form validation and submission handling powered by src/scripts/contact.ts.
 *
 * HOW TO MAINTAIN:
 * - To change the inbox where messages are sent:
 *   update the `data-recipient` attribute on the <form> below
 *   (currently set to: "justin.day@pursuit.org").
 * ============================================================================
 */
---

<section id="contact" class="contact-section container">
  <h2>Contact</h2>
  <p>
    I am a driven, coachable engineer who combines technical skill with
    strong collaboration and real-world adaptability. If your team values
    someone who can communicate clearly, solve problems creatively, and
    ramp up quickly, I would welcome the chance to speak with you.
  </p>
  <p>
    You can reach me through the form or using the contact information below. I look forward
    to connecting.
  </p>
  <form
    id="contact-form"
    class="contact-form"
    autocomplete="off"
    novalidate
    data-recipient="justin.day@pursuit.org"
  >
    <div class="form-field">
      <label for="contact-return-email">Your Email</label>
      <input
        id="contact-return-email"
        name="contact_return_email"
        type="email"
        required
        autocomplete="off"
        autocapitalize="off"
        autocorrect="off"
        spellcheck="false"
        inputmode="email"
        placeholder="name@example.com"
      />
    </div>

    <div class="form-field">
      <label for="contact-subject">Subject</label>
      <input
        id="contact-subject"
        name="contact_subject"
        type="text"
        required
        autocomplete="off"
        autocapitalize="sentences"
        autocorrect="off"
        spellcheck="false"
        placeholder="How can we collaborate?"
      />
    </div>

    <div class="form-field">
      <label for="contact-message">Inquiry</label>
      <textarea
        id="contact-message"
        name="contact_message"
        rows="6"
        required
        autocomplete="off"
        autocapitalize="sentences"
        autocorrect="off"
        spellcheck="false"
        placeholder="Share details about the opportunity..."
      ></textarea>
    </div>

    <button type="submit" class="connect-button" disabled>Let's Connect</button>
    <p id="contact-form-status" class="contact-form-status" role="status" aria-live="polite"></p>
  </form>
</section>

<!-- Load TypeScript contact form validation and submission behavior -->
<script src="../scripts/contact.ts"></script>
